# ── Copy this to .env and fill in your values ──────────────────
# cp .env.example .env

# ── Frontend ────────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:8000

# ── Backend auth ─────────────────────────────────────────────────
# Leave both blank to disable auth (local dev only)
SENTINEL_API_KEY=
# Firebase service-account JSON, on ONE line, in single quotes:
# FIREBASE_CREDENTIALS_JSON='{"type":"service_account","project_id":"...",...}'

# ── LLM Configuration ────────────────────────────────────────────
# LLM_PROVIDER: "groq" (default, cloud) or "ollama" (local/offline)
LLM_PROVIDER=groq

# ── Groq (Primary Provider) ──────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# Optional: override the models (list available ones with
# GET https://api.groq.com/openai/v1/models)
# GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
# GROQ_MODEL_FALLBACK=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.2

# ── Gemini (optional fallback when Groq fails) ───────────────────
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Seconds before a Groq/Gemini call is abandoned (default 45)
# LLM_TIMEOUT_SECONDS=45

# ── Ollama (Fallback — local/offline dev) ────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=60

# ── CORS ─────────────────────────────────────────────────────────
# Use * for dev. In production: https://yourfrontend.com
ALLOWED_ORIGINS=*

# ── Database ─────────────────────────────────────────────────────
SENTINEL_DB_PATH=/data/sentinel.db
