# API Sentinel - environment variables
#
#   cp .env.example .env      (then fill in what you need)
#
# The backend reads ../.env (this file's location) on startup, and
# docker compose reads it to fill in docker-compose.yml. Every variable is
# optional: with nothing set the app runs locally with no sign-in check and
# rule-based analysis only (no LLM).
#
# Never commit .env - it is in .gitignore.

# ── LLM ──────────────────────────────────────────────────────────
# Which provider the agents call: groq (default), gemini or ollama.
# If the call fails or no key is set, each agent falls back to its
# rule-based logic, so scans still complete.
LLM_PROVIDER=groq

# Groq - free key at https://console.groq.com
GROQ_API_KEY=
# Model overrides (defaults shown). List the models your key can use:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
# GROQ_MODEL_FALLBACK=openai/gpt-oss-20b
# GROQ_MODEL=               # legacy name for GROQ_MODEL_PRIMARY
# GROQ_TEMPERATURE=0.2

# Gemini - used when LLM_PROVIDER=gemini, or as a fallback when Groq is
# rate-limited or all Groq models fail. Key: https://aistudio.google.com
GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Ollama - only when LLM_PROVIDER=ollama (local models, no key)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_DEFAULT_MODEL=llama3.1:8b
# OLLAMA_TIMEOUT=60

# Seconds before a Groq/Gemini request is abandoned
# LLM_TIMEOUT_SECONDS=45

# ── Authentication (backend) ─────────────────────────────────────
# Production: Firebase service-account JSON on ONE line, in single quotes.
# When set, every API request needs a Firebase ID token (the web UI's
# Google sign-in provides it).
# FIREBASE_CREDENTIALS_JSON='{"type":"service_account","project_id":"<project-id>",...}'
# ...or a path to the service-account file (not passed through by docker-compose):
# FIREBASE_CREDENTIALS=/path/to/service-account.json
#
# Dev mode (no Firebase credentials): if this is set, API calls must send
# "Authorization: ApiKey <key>". The web UI does not send it, so leave it
# blank when using the UI.
SENTINEL_API_KEY=

# ── Backend server ───────────────────────────────────────────────
# Comma-separated origins allowed to call the API, or * (dev only)
ALLOWED_ORIGINS=*
# SQLite file. Default: backend/sentinel.db. docker-compose sets
# /data/sentinel.db (a volume) itself, so leave this commented locally.
# SENTINEL_DB_PATH=./sentinel.db

# ── Frontend ─────────────────────────────────────────────────────
# React reads frontend/.env.development (npm start) and
# frontend/.env.production (npm run build), not this file. The one value
# used from here is the backend URL docker compose bakes into its build.
REACT_APP_API_URL=http://localhost:8000
# Display name in the UI (set in frontend/.env.*; default "API Sentinel")
# REACT_APP_APP_NAME=API Sentinel
